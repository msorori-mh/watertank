# نسخة توضيحية فقط — لا تضع مفاتيح حقيقية في المستودع.
# انسخ هذا الملف إلى android/keystore.properties (مُستثنى من git) وعبّئ القيم محلياً،
# أو استخدم متغيرات البيئة البديلة الموضحة أمام كل حقل.

# مسار ملف المفاتيح نسبةً إلى مجلد android/   (env: WAYETMAA_KEYSTORE_PATH)
storeFile=wayetmaa-release.keystore
# كلمة مرور ملف المفاتيح                      (env: WAYETMAA_KEYSTORE_PASSWORD)
storePassword=
# اسم الـ alias                                (env: WAYETMAA_KEY_ALIAS)
keyAlias=wayetmaa
# كلمة مرور الـ alias                          (env: WAYETMAA_KEY_PASSWORD)
keyPassword=

# إذا لم تتوفر القيم الأربع، فإن bundleRelease/assembleRelease ينتج ملفاً غير موقّع (unsigned).
